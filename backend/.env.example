APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# -----------------------------------------------------------------------------
# External student registry import (read-only credentials recommended)
# -----------------------------------------------------------------------------
STUDENT_IMPORT_ENABLED=false
STUDENT_IMPORT_DB_CONNECTION=source_students
STUDENT_IMPORT_TABLE=external_students
STUDENT_IMPORT_CHUNK_SIZE=500
STUDENT_IMPORT_LOCK_TTL=900
STUDENT_IMPORT_CRON="0 2 * * *"

SOURCE_DB_CONNECTION=mysql
# SOURCE_DB_URL=
SOURCE_DB_HOST=127.0.0.1
SOURCE_DB_PORT=3306
SOURCE_DB_DATABASE=sis_readonly
SOURCE_DB_USERNAME=sis_import_ro
SOURCE_DB_PASSWORD=
# SOURCE_DB_CHARSET=utf8mb4
# SOURCE_DB_COLLATION=utf8mb4_unicode_ci

# Column names on the *source* table (defaults assume matching app attribute names)
STUDENT_IMPORT_COL_EXTERNAL_ID=external_account_id
STUDENT_IMPORT_COL_EMAIL=primary_email
STUDENT_IMPORT_COL_FULL_NAME=full_name
STUDENT_IMPORT_COL_DEPARTMENT=department
STUDENT_IMPORT_COL_SCHOOL_YEAR=school_year
STUDENT_IMPORT_COL_GRADUATION_DATE=graduation_date
STUDENT_IMPORT_COL_GRADUATION_STATUS=graduation_status
STUDENT_IMPORT_COL_DEGREE=degree_program
# Leave empty if the source has no suspended flag column
STUDENT_IMPORT_COL_SUSPENDED=

# CARES / lgrrs style: leave STUDENT_IMPORT_COL_EMAIL empty and use CSV and/or generated CEU email (see below).
# STUDENT_IMPORT_ORDER_BY_COLUMN=SZSTUID
# STUDENT_IMPORT_COMPOSITE_FULL_NAME=SZFNAME,SZMNAME,SZLNAME
# STUDENT_IMPORT_EMAIL_CSV_PATH=
# STUDENT_IMPORT_EMAIL_CSV_ID_COLUMN=SZSTUID
# STUDENT_IMPORT_EMAIL_CSV_EMAIL_COLUMN=primary_email
#
# CEU "Email List Creation Formula" (no CSV): LOWER(SUBSTITUTE(LastName," ","") & RIGHT(LEFT(ID,4),2) & RIGHT(ID,N)) &
#   IF(LEFT(ID,4)="2025","@mnl.ceu.edu.ph","@ceu.edu.ph")
# STUDENT_IMPORT_GENERATE_PRIMARY_EMAIL=false
# STUDENT_IMPORT_EMAIL_FORMULA_LAST_NAME_COLUMN=SZLNAME
# STUDENT_IMPORT_EMAIL_FORMULA_ID_SUFFIX_LENGTH=5
# STUDENT_IMPORT_EMAIL_FORMULA_MNL_YEAR_PREFIX=2025
# STUDENT_IMPORT_EMAIL_DOMAIN_MNL=@mnl.ceu.edu.ph
# STUDENT_IMPORT_EMAIL_DOMAIN_DEFAULT=@ceu.edu.ph

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
DELETE_CONFIRMATION_PHRASE="DELETE STUDENT ACCOUNTS"
BULK_ACCOUNT_IDS_MAX=500
# Set true to exercise delete API/jobs without removing Workspace users or DB rows
STUDENT_DELETE_DRY_RUN=false

# Comma-separated origins for browser clients (use specific origins in production)
CORS_ALLOWED_ORIGINS="*"

POLICY_EVALUATION_CRON="*/15 * * * *"
SUSPENDED_DUE_DATE_CRON="*/15 * * * *"
AUTOMATION_NOTIFICATIONS_ENABLED=false
AUTOMATION_NOTIFICATION_RECIPIENTS=

# -----------------------------------------------------------------------------
# Google Workspace — delete users via Admin SDK when students are removed (optional)
# -----------------------------------------------------------------------------
GOOGLE_WORKSPACE_DELETE_ENABLED=false
# Absolute path or path relative to backend/ project root
GOOGLE_WORKSPACE_CREDENTIALS_PATH=
# Super admin or delegated admin email (domain-wide delegation)
GOOGLE_WORKSPACE_IMPERSONATE_EMAIL=
# external_account_id | primary_email (Directory API userKey)
GOOGLE_WORKSPACE_DELETE_USER_KEY=external_account_id
# Comma-separated; default: https://www.googleapis.com/auth/admin.directory.user
# GOOGLE_WORKSPACE_SCOPES=

# -----------------------------------------------------------------------------
# Laravel Telescope (composer require --dev). Disabled in phpunit by default.
# -----------------------------------------------------------------------------
TELESCOPE_ENABLED=true
# Non-local only: comma-separated emails that may open /telescope (web session user)
# TELESCOPE_ALLOWED_EMAILS=admin@example.com

VITE_APP_NAME="${APP_NAME}"
